# LandSight — Backend Environment Variables
# Copy this file to .env and fill in your values.
# Do NOT commit .env to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (no server needed, file stored in backend/):
DATABASE_URL=sqlite:///landsight.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/land_classification

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_DEBUG=true
PORT=5000

# REQUIRED in production — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Defaults to localhost dev ports if not set.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production example:
# ALLOWED_ORIGINS=https://landsight.yourdomain.com

# ── ML Model ──────────────────────────────────────────────────────────────────
# URL to download the model if not present locally.
# Update this when you release a new model version.
MODEL_DOWNLOAD_URL=https://github.com/CrypticRye/LandSight/releases/download/v1.0-model/LandClassification.keras

# ── Copernicus Data Space Ecosystem (Sentinel-2) ──────────────────────────────
# Register for FREE at: https://dataspace.copernicus.eu
COPERNICUS_USER=your_email@example.com
COPERNICUS_PASS=your_password
